# Chul Farm — Silk Management System (frontend)
# Copy to `.env.local`. Never commit real credentials or tokens (§14).

# Base URL of the backend API. Ignored while VITE_USE_MOCK_API=true.
VITE_API_BASE_URL=/api

# true  → typed mock adapter (no backend required)
# false → real HTTP adapter against VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Simulated latency of the mock adapter, in milliseconds.
VITE_MOCK_LATENCY=320
